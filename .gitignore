# ============================================================================
# Blood_Link — Master Production Git Ignore Configuration
# ============================================================================

# 1. Package Dependencies (Root and Child Workspaces)
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# 2. Build Outputs & Compilations
dist/
client/dist/
server/dist/
build/
.next/
coverage/
*.tsbuildinfo

# 3. Environment Variables & Secret Credentials (CRITICAL)
# Recursively exclude all .env files across all subdirectories
**/.env
**/.env.*
# Explicit exception: allow non-sensitive example templates
!**/.env.example

# 4. Local Evaluation Credentials & Private Notes
docs/*.local.md
docs/DEMO_CREDENTIALS.local.md
*.secret.md

# 5. Cryptographic Keys, Certificates & Tokens
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
id_rsa*
*.pub

# 6. Local SQLite Databases, WALs & Storage
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
server/blood_link.db
local_storage/

# 7. Diagnostics, Logs & Debug Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 8. Operating System & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.fleet/
.antigravity/

# 9. Ephemeral Staging & Temporary Files
.tmp/
temp/
scratch/
