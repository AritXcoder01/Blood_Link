# ==============================================================================
# Blood_Link Server Environment Configuration Template
# ==============================================================================
# Copy this file to `server/.env` for local development.
# WARNING: NEVER commit real passwords, secret keys, or service-role keys to git!
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Authentication
# In production with Supabase, set JWT_SECRET to your Supabase project's JWT Secret
# (Found in: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret)
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production
JWT_EXPIRES_IN=7d

# Database Configuration
# Local Development: Set DB_CLIENT=sqlite for zero-config SQLite mode.
# Production Deployment: Set DB_CLIENT=postgres and supply your Supabase Connection String.
DB_CLIENT=sqlite

# Supabase Managed PostgreSQL Connection String:
# For production on Supabase, obtain the connection URI from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use Mode: Transaction (Port 6543) for serverless environments (e.g. Vercel)
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase Project Credentials (Server-side privileged access only)
# Project URL: https://[PROJECT_REF].supabase.co
SUPABASE_URL=
# Service Role Key (NEVER expose to client/frontend code! Keep server-only!)
SUPABASE_SERVICE_ROLE_KEY=

# External Services (Leave empty or set to 'demo' for local evaluation mode)
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_SERVER_KEY=

# Evaluation Mode Flag (Disabled automatically in production)
DEMO_MODE=true
