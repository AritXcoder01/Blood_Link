# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production
JWT_EXPIRES_IN=7d

# Database Configuration
# Set to 'postgres' to use PostgreSQL, or 'sqlite' for automatic zero-config local development
DB_CLIENT=sqlite
# For PostgreSQL (if available):
DATABASE_URL=postgresql://username:password@localhost:5432/blood_link_db

# External Services (Leave blank or 'demo' for explicit Demo Mode)
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_SERVER_KEY=
DEMO_MODE=true
