# ==============================================================================
# Blood_Link Monorepo Environment Configuration Template
# ==============================================================================
# Use this reference when configuring production hosting environments (e.g. Vercel, Supabase).
# WARNING: NEVER commit actual passwords, private keys, or API secrets!
# ==============================================================================

# Server Runtime Settings
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Authentication
# In production, set JWT_SECRET to your Supabase Project JWT Secret
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production
JWT_EXPIRES_IN=7d

# Database Configuration
# Local Development: 'sqlite' | Production: 'postgres'
DB_CLIENT=sqlite

# Supabase PostgreSQL Connection String (Port 6543 Transaction Pooler recommended)
# postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase Server-Side API Credentials (Server-only! Never expose to client!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Vite Public Keys (Safe for client builds if direct Supabase client is used)
# VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# External Services
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_SERVER_KEY=
DEMO_MODE=true
